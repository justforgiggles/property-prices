{
  "name": "@property-prices/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node --import tsx scripts/generate-insights.ts",
    "dev": "npm run generate && next dev",
    "build": "npm run generate && next build && node scripts/export-metadata.mjs",
    "preview": "node scripts/serve-export.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "test:export": "node --import tsx scripts/verify-export.ts",
    "verify:data": "node --import tsx scripts/verify-python-parity.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/manrope": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
