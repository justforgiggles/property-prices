{
  "name": "property-prices",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/data",
    "packages/model"
  ],
  "scripts": {
    "submissions": "sh scripts/submissions.sh",
    "scrape": "npm run scrape -w @property-prices/data --",
    "train": "sh scripts/train.sh",
    "test": "npm test -w @property-prices/data && packages/model/.venv/bin/python scripts/test-scripts.py",
    "build": "npm run build -w @property-prices/data"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
