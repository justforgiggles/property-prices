{
  "name": "property-prices",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/data",
    "packages/model",
    "packages/website"
  ],
  "scripts": {
    "website:dev": "npm run dev -w @property-prices/website",
    "website:build": "npm run build -w @property-prices/website",
    "website:test": "npm test -w @property-prices/website",
    "submissions": "sh scripts/submissions.sh",
    "scrape": "npm run scrape -w @property-prices/data --",
    "train": "sh scripts/train.sh",
    "agents": "node scripts/agents.mjs",
    "deploy": "sh scripts/deploy.sh",
    "test": "npm test -w @property-prices/data && node --test tests/*.test.mjs && packages/model/.venv/bin/python -m unittest discover -s tests -p \"test_*.py\" && packages/model/.venv/bin/python -m unittest discover -s packages/model/tests",
    "build": "npm run build -w @property-prices/data"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "js-yaml": "^5.5.0",
    "sharp": "^0.35.5"
  }
}
