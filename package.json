{
  "name": "prop-radar",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/data",
    "packages/model"
  ],
  "scripts": {
    "submissions": "sh scripts/submissions.sh",
    "scrape": "npm run scrape -w @prop-radar/data --",
    "train": "sh scripts/train.sh",
    "agents": "node scripts/agents.mjs",
    "deploy": "sh scripts/deploy.sh",
    "test": "node --test tests/*.test.mjs && packages/model/.venv/bin/python -m unittest discover -s packages/model/tests",
    "build": "npm run build -w @prop-radar/data"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "js-yaml": "^5.5.0",
    "sharp": "^0.35.5"
  }
}
